# --- Local development: a SQLite file on disk (relative paths resolve from the repo root).
CHESS_COACH_DB=./data/chess-coach.db

# --- Hosted deployment: set both, and CHESS_COACH_DB is ignored.
# The same libSQL driver serves both, so local and deployed runs take one code path.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-token

# Contact string embedded in the Chess.com API User-Agent, per their PubAPI etiquette.
CHESS_COACH_CONTACT=your-email@example.com

# Optional: absolute path to the Stockfish binary. Auto-detected when omitted.
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Set to 1 where there is no Stockfish binary to shell out to (any hosted
# deployment). The analysis then runs in the visitor's browser and is uploaded.
# CHESS_COACH_DISABLE_LOCAL_ENGINE=1
