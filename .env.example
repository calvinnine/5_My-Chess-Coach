# Where the local SQLite database lives (relative paths resolve from the repo root).
CHESS_COACH_DB=./data/chess-coach.db

# Contact string embedded in the Chess.com API User-Agent, per their PubAPI etiquette.
CHESS_COACH_CONTACT=your-email@example.com

# Optional: absolute path to the Stockfish binary. Auto-detected when omitted.
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish
